# StayPilot Cloudflare Pages server environment
# Copy to .dev.vars for local Functions development only.
# Never commit .dev.vars or real credentials.

SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SECRET_KEY=YOUR_SERVER_ONLY_SUPABASE_SECRET
WEBHOOK_SIGNING_SECRET=GENERATE_A_LONG_RANDOM_SECRET
WORKER_SECRET=GENERATE_A_SEPARATE_LONG_RANDOM_SECRET
DISPATCHER_SECRET=GENERATE_A_SEPARATE_LONG_RANDOM_SECRET
WEBHOOK_ALLOWED_HOSTS=hooks.example.com,workflow.example.com
WEBHOOK_SECRET_DEMO_OUTBOUND=PER_ENDPOINT_SIGNING_SECRET
OUTBOUND_SIGNING_MASTER_SECRET=GENERATE_A_SEPARATE_LONG_RANDOM_MASTER_SECRET
ORCHESTRATOR_SECRET=GENERATE_A_SEPARATE_LONG_RANDOM_SECRET
ORCHESTRATOR_ENABLED=false
TENANT_BOOTSTRAP_ENABLED=false
TEAM_INVITES_ENABLED=false
